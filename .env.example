# Gümüş Kozmetik Firebase Configuration Settings
# Copy this file to `.env` and fill in your actual Firebase Web App credentials.
# These variables should also be set in your Cloudflare Pages dashboard settings.

VITE_FIREBASE_API_KEY=your-actual-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=gkgumus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gkgumus
VITE_FIREBASE_STORAGE_BUCKET=gkgumus.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
